{
  "name": "tailzaar-nemotron-wrapper",
  "version": "1.0.0",
  "description": "A small, dependency-free TypeScript client for NVIDIA Nemotron on Nebius Token Factory, built for the TailZaar pet assistant.",
  "license": "MIT",
  "main": "dist/token-factory-chat.js",
  "types": "dist/token-factory-chat.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx examples/chat.ts",
    "example:stream": "tsx examples/chat.ts --stream"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
